# Copy to .env (or let scripts/setup_mysql.ps1 generate .env automatically)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bengaluru_transit
DB_URL=jdbc:mysql://localhost:3306/bengaluru_transit?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USER=btc_app
DB_PASS=replace_with_local_db_password
JWT_SECRET=replace_with_at_least_32_char_random_jwt_secret_key
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api